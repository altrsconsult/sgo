# Estágio 1: build do frontend React
FROM node:20-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm

# Copia configuração do workspace (tsconfig base para extends)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.json ./
COPY packages/ packages/

# Copia o frontend e suas dependências
COPY chassi/frontend/ chassi/frontend/

# Versão injetada pelo CI a partir do tag (ex.: v4.5.6 → 4.5.6); garante login/badge corretos na imagem
ARG VERSION
RUN if [ -n "$VERSION" ]; then node -e "const fs=require('fs'); const p=JSON.parse(fs.readFileSync('chassi/frontend/package.json','utf8')); p.version='$VERSION'; fs.writeFileSync('chassi/frontend/package.json', JSON.stringify(p, null, 2));"; fi

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @sgo/chassi-frontend build

# Estágio 2: nginx servindo os arquivos estáticos
FROM nginx:alpine
COPY --from=builder /app/chassi/frontend/dist /usr/share/nginx/html
COPY chassi/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
